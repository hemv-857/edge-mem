# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.venv/
.pytest_cache/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# python bytecode (edge-engine runs on the local interpreter)
__pycache__/
*.pyc
# qdrant server runtime (binary + storage) bootstrapped by start.sh
/.qdrant/
# e2e audit screenshot artifacts — tests/audit/audit.py is the durable artifact
tests/audit/shots/
# device-beta peer runtime spawned by mini-services/edge-engine/start.sh
mini-services/edge-engine/data-beta/
