# Copy to .env (git-ignored) and fill in. Never commit real keys.
DATABASE_URL=file:../db/custom.db

# Cloud LLM — any OpenAI-compatible /chat/completions endpoint (OpenAI, Groq,
# Together, Ollama, vLLM, Z.ai …). Defaults are used when these are unset.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<your-api-key>
# LLM_MODEL=gpt-4o-mini

# Edge engine shared secret (header X-Edge-Token), optional locally —
# required in any deployed environment (the engine is world-reachable there).
# EDGE_TOKEN=<random-string>

# --- deploy (both engines remote) ------------------------------------------
# Remote engine base URL. Set on Vercel: the /api/edge gateway and the SSE
# relay proxy here instead of 127.0.0.1. Unset = loopback (local dev).
# EDGE_URL=https://edge-mem-engine.onrender.com
# Hostnames the Next.js host guard accepts, comma-separated. Vercel's own
# deployment hostnames are allowed automatically; add only custom domains.
# EDGE_ALLOWED_HOSTS=edge.example.com
# EDGE_PORTS=3030,3031

# Qdrant cloud: start.sh enables auth with this key and the engine presents it.
# QDRANT_API_KEY=<random-string>
